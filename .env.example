# Copy to .env and edit. `docker compose` reads this automatically.

# --- database (TimescaleDB) --------------------------------------------------
POSTGRES_USER=winnow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=winnow
DATABASE_URL=postgres://winnow:change-me@db:5432/winnow

# --- capture / SDR -----------------------------------------------------------
CAPTURE_MOCK=0
# auto = detect and use every connected RTL-SDR (each tagged by its serial, so
# USB index ordering never matters). Or pin a comma list of indices: 0,1,2
RTL_DEVICES=auto
RTLAMR_MSGTYPE=scm,scm+,idm
RTLAMR_FILTERID=
FREQ=912600155
GAIN=
PPM=0

# --- app ---------------------------------------------------------------------
APP_PORT=8000

# --- Home Assistant + MQTT (OPTIONAL bootstrap) ------------------------------
# These are normally set in the dashboard (Settings → Integrations) and stored
# in the DB. Uncomment only if you want them seeded from the environment.
# HA_URL=https://ha.example.com
# HA_TOKEN=
# MQTT_HOST=ha.example.com
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASSWORD=
# MQTT_PREFIX=homeassistant
