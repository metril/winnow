# Copy to .env and edit. `docker compose` reads this automatically.

# --- database (PostgreSQL) ---------------------------------------------------
POSTGRES_USER=meterfinder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meterfinder
# capture + app reach the db service over the compose network:
DATABASE_URL=postgresql://meterfinder:change-me@db:5432/meterfinder

# --- capture / SDR -----------------------------------------------------------
# Use synthetic data (no SDR needed) to try the dashboard: set to 1.
CAPTURE_MOCK=0

# Comma-separated RTL-SDR device indices OR serials, one per dongle.
#   RTL_DEVICES=0            single dongle
#   RTL_DEVICES=0,1,2        three dongles
#   RTL_DEVICES=heater,roof  by serial (assign with `rtl_eeprom -d N -s NAME`)
RTL_DEVICES=0

# rtlamr message types to decode.
RTLAMR_MSGTYPE=scm,scm+,idm

# Leave empty during discovery. After locking your meter, set it to capture
# only that ID (the dashboard shows the exact command to use downstream).
RTLAMR_FILTERID=

# SDR tuning. FREQ is rtlamr's default ERT center frequency.
FREQ=912600155
GAIN=
PPM=0

# --- app ---------------------------------------------------------------------
APP_PORT=8000
